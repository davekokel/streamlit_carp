-def _next_fish_code(prefix: str = "FSH") -> str:
-    yr = date.today().year
-    try:
-        q = sb.table("fish").select("fish_code").like("fish_code", f"{prefix}-{yr}-%").order("fish_code", desc=True).limit(1)
-        last = (q.execute().data or [])
